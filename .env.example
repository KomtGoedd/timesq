# Copy this file to .env and fill in your own values. Never commit .env.

# Long random string used to sign sessions and CSRF tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Optional: override the database location (defaults to instance/timesquare.db).
# DATABASE_URL=sqlite:///C:/pad/naar/timesquare.db

# 1 = auto-reload and debugger while developing, 0 = off.
FLASK_DEBUG=1
